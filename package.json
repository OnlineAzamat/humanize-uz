{
  "name": "humanize-uz",
  "version": "1.0.0",
  "description": "Raqam va sanalarni O‘zbek tilida inson o‘qiydigan ko‘rinishga keltiruvchi kutubxona",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepack": "npm run build",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "humanize",
    "uzbek",
    "uzbekistan",
    "uz",
    "date",
    "number",
    "human-readable",
    "format",
    "localization",
    "i18n",
    "timeago",
    "intl"
  ],
  "author": "Azamat Yakubbaev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OnlineAzamat/humanize-uz.git"
  },
  "homepage": "https://github.com/onlineazamat/humanize-uz#readme",
  "bugs": {
    "url": "https://github.com/onlineazamat/humanize-uz/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  }
}
